# Copy to .env.local. Vite only exposes variables prefixed VITE_.

# Origin of the API, no trailing slash. Cloudflare Pages sets this per environment.
VITE_API_BASE_URL=http://localhost:8787

# 1 = run against @skinny/api-client/mock instead of the API. Playwright and Pages previews use it.
VITE_MOCK=1

# Dev only, and only when the API runs AUTH_MODE=test: sent as `x-test-uid` (ruling R17).
VITE_TEST_UID=

# Firebase web app (auth + messaging). See docs/deploy/firebase.md.
# All five below must be set or the app falls back to the mock in dev and renders a
# configuration-error screen in production (it never boots an unconfigured Firebase app).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Web Push certificate key pair from Firebase Console → Cloud Messaging.
VITE_FIREBASE_VAPID_KEY=
