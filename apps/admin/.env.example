# Base URL of the Hono API (no trailing slash). Local API default port is 3000.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# 1 = use MockAdminApi with seeded fixtures, skip Firebase entirely. Never set in production.
NEXT_PUBLIC_MOCK=1

# Firebase Web app config (Project settings -> Your apps -> Web app). Required when NEXT_PUBLIC_MOCK is not 1.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
