{
  "name": "skinny-legend",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "pretest": "pnpm --filter @skinny/shared build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "predev:api": "pnpm --filter @skinny/shared build",
    "dev:api": "pnpm --filter @skinny/api dev",
    "dev:admin": "pnpm --filter @skinny/admin dev",
    "db:up": "docker compose up -d db",
    "e2e": "pnpm --filter @skinny/e2e e2e",
    "e2e:headed": "pnpm --filter @skinny/e2e e2e:headed",
    "e2e:down": "docker compose rm -sfv db auth-emulator",
    "db:migrate": "pnpm --filter @skinny/api db:migrate"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "tsx": "^4.19.0"
  }
}
