DATABASE_URL=postgres://skinny:skinny@localhost:5432/skinny
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=skinny-legend
OPENROUTER_API_KEY=
VISION_MODEL=qwen/qwen3.7-flash
PORT=3000
# Comma-separated browser origins allowed to call the API (the admin dashboard).
# Add the Vercel production domain here when the dashboard is deployed.
CORS_ORIGINS=http://localhost:3001
# AUTH_MODE=test disables auth and uses in-memory storage; never set in production (the API refuses to boot with NODE_ENV=production).
# It is the local default so the API boots without Firebase/R2/OpenRouter credentials —
# fill the secrets above and delete this line to exercise the real integrations locally.
AUTH_MODE=test
# Prefixed onto every object key the API creates (e.g. STORAGE_KEY_PREFIX=e2e/ → "e2e/photos/…"),
# so an end-to-end run's objects are separable from production's and sweepable at teardown.
# A value without a trailing slash gets one. Leave empty outside the e2e suite.
STORAGE_KEY_PREFIX=
# Host:port of a running Firebase Auth Emulator, e.g. localhost:9099. Set only by the local/CI
# end-to-end suite: it swaps the service account for a project id and forces the fake push sender.
# The firebase-admin SDK reads this variable from process.env directly, so it must be exported
# into the API process's environment (this file is loaded via dotenv) and never set in production —
# the API refuses to boot with it set and NODE_ENV=production.
FIREBASE_AUTH_EMULATOR_HOST=
